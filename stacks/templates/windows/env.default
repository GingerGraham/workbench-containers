# Settings for this Windows stack, read by compose from this file.
# Change them here, not in compose.yaml, then run: stack-down <name>; stack-up <name>
#
# Values here win over the same names exported in your shell: the stack-*
# functions unset those before running compose.
#
# WINDOWS_VERSION, WINDOWS_USERNAME and WINDOWS_PASSWORD only apply when
# Windows is first installed.
# WINDOWS_VERSION values: 11, 10, 2022, tiny11 and others (dockur/windows docs).
WINDOWS_VERSION=11
WINDOWS_RAM_SIZE=4G
WINDOWS_CPU_CORES=2
WINDOWS_DISK_SIZE=64G
# user: passt user-mode networking, which needs no extra privileges.
# Forwarding another port into Windows (SSH, WinRM) takes a ports: entry
# and a USER_PORTS entry under environment: in compose.yaml.
WINDOWS_NETWORK=user
