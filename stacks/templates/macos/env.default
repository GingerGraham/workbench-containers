# Settings for this macOS stack, read by compose from this file.
# Change them here, not in compose.yaml, then run: stack-down <name>; stack-up <name>
# Every option dockur/macos accepts: https://github.com/dockur/macos
#
# Values here win over the same names exported in your shell: the stack-*
# functions unset those before running compose.
#
# MACOS_VERSION only applies when macOS is first installed.
# MACOS_VERSION values: 15 (Sequoia), 14 (Sonoma), 13 (Ventura),
# 12 (Monterey), 11 (Big Sur). 26 (Tahoe) works but runs very slowly.
MACOS_VERSION=15
# On AMD hosts, keep this at 8G or less until macOS is installed.
MACOS_RAM_SIZE=4G
MACOS_CPU_CORES=2
# Raising it later grows the disk at the next start; then, in macOS:
#   diskutil repairDisk disk2 && diskutil apfs resizeContainer disk3 0
MACOS_DISK_SIZE=64G
# user: passt user-mode networking, which needs no extra privileges.
# Forwarding another port into macOS (SSH) takes a ports: entry and a
# USER_PORTS entry under environment: in compose.yaml.
MACOS_NETWORK=user
